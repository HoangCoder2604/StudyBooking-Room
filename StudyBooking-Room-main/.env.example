# Backend security secret. Set this in Vercel Project Settings -> Environment Variables.
TOKEN_SECRET=replace-with-a-long-random-secret

# IMPORTANT:
# On Vercel, the default SQLite path is /tmp/studyroom.db.
# /tmp is NOT persistent across deployments/cold starts.
# For real persistent production data, configure an external database
# (recommended: Turso/Neon/Supabase) before production use.
# DB_PATH=/tmp/studyroom.db

# Frontend API base URL. For same-domain Vercel deployment use:
EXPO_PUBLIC_API_URL=
