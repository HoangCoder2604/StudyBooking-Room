# Configure these in Vercel Project > Settings > Environment Variables.
# Create a Turso (libSQL) database first; production must NOT use local SQLite.
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_DATABASE_AUTH_TOKEN
TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Optional for Android builds only. For Vercel Web, leave unset: it uses same-origin /api.
# EXPO_PUBLIC_API_URL=https://YOUR-PROJECT.vercel.app
